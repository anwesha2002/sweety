# Copy to server/.env.test (never put real URLs in this example file; it is committed).
# Tests TRUNCATE all tables, so DATABASE_URL must point at a SEPARATE database: its name ends
# in "_test", or it is on a different server than the dev database in server/.env (for example
# a separate Neon branch). The test setup refuses to run otherwise.
NODE_ENV=test
PORT=4001

DATABASE_URL=postgresql://sweety:sweety@localhost:5434/sweety_test

JWT_SECRET=test-secret-test-secret-test-secret-0123456789
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Low cost factor keeps the tests fast
BCRYPT_ROUNDS=4
TRUST_PROXY=false
