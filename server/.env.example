# Copy to server/.env and adjust. Never commit the real file.
NODE_ENV=development
PORT=4000

# Local Docker Postgres from docker-compose.yml (host port 5434).
# For a hosted database, use its connection string instead (usually with ?sslmode=require).
DATABASE_URL=postgresql://sweety:sweety@localhost:5434/sweety

# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1d

# Origin of the React app (used for CORS)
CLIENT_URL=http://localhost:5173

BCRYPT_ROUNDS=12

# Set to a number of proxy hops (e.g. 1) or true when running behind a reverse proxy
TRUST_PROXY=false

# Single-container deployments only (see the root Dockerfile): folder with the built React app
# that the API should serve too. Leave unset in development; Vite serves the app there.
# CLIENT_DIST_DIR=/app/client-dist
