# Settings for docker-compose.prod.yml. Copy to .env.production and fill in. NEVER commit the real file.
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# The address people open in the browser, with no trailing slash. Must be https:// in production
# (the login cookie is marked Secure). Used for the API's CORS setting.
PUBLIC_URL=https://sweety.example.com

# Database. Use letters and digits only in the password (it becomes part of a connection URL).
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_USER=sweety
POSTGRES_PASSWORD=
POSTGRES_DB=sweety

# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# Proxies in front of the API: nginx is 1. Use 2 when a platform/TLS proxy sits in front of nginx.
TRUST_PROXY=1

# Host port for the web container (put your TLS proxy in front of this).
WEB_PORT=8080
